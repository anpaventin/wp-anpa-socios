# Example env for the EPHEMERAL integration harness. Copy to `.env.integration`
# (which is git-ignored) and set your own throwaway values. NEVER put real
# credentials or production hosts here. The DB name MUST contain "test" or
# "integration". The table prefix MUST start with "wpint_".

MYSQL_IMAGE=mysql:8.0            # or mariadb:10.6
DB_PORT=33061

WP_TESTS_DB_NAME=wp_anpa_integration_test
WP_TESTS_DB_USER=wp_anpa_it
WP_TESTS_DB_PASS=changeme_ephemeral_only
MYSQL_ROOT_PASSWORD=root_ephemeral_only
WP_TESTS_DB_HOST=127.0.0.1

WP_TESTS_TABLE_PREFIX=wpint_
WP_TESTS_DOMAIN=example.org
WP_TESTS_DIR=/tmp/wordpress-tests-lib
WP_CORE_DIR=/tmp/wordpress

# Non-UTC timezone to exercise the UTC convention.
DB_TZ=America/Argentina/Buenos_Aires
DB_TZ_SQL=-03:00
