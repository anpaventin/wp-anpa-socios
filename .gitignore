# ANPA Socios plugin — repo-level .gitignore (nando/wp-anpa-socios)

# Dev dependencies (phpunit etc.) — not shipped
/vendor/
/node_modules/

# PHPUnit caches
.phpunit.result.cache
.phpunit.cache

# Local test/scratch output
out.txt
po.txt
pub.txt
*.log
/nul

# Local pre-deploy backups — preserve on disk, never publish
/bak/

# Local planning / agent artefacts (not shipped in the public plugin ZIP/repo)
/AGENTS.md
/IDEA.md
/openspec/
/.hermes/
/.agents/
/.claude/
/.sync/
/.atl/
/CLAUDE.md
/AGENTS.local.md
/TODO.local.md
/notes.local.md
/wp-content/

# Future local development artefacts: keep SDDs, agent scratchpads, downloaded
# WordPress trees, migration sandboxes and other non-plugin work outside GitHub.
*.local.md
*.scratch.md
*.tmp.md
*.bak
*.zip

# Integration harness: real credentials and captured evidence never get committed.
# Only .env.integration.example (fictitious values) is versioned.
/tests/integration/.env.integration
/tests/integration/.env.integration.local
/.integration-evidence/

# CI workflows are NOT pushed to the public repo yet: the deploy token lacks the
# GitHub `workflow` scope, so a push touching .github/workflows/ is rejected.
# The workflow is versioned in the private monorepo meanwhile. Remove this rule
# once a token with `workflow` scope is available.
/.github/

# OS / editor
.DS_Store
Thumbs.db
*.swp
